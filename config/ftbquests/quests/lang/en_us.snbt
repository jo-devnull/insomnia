	quest.25285950671364AE.title: "Medicina"
	quest.27A9B9AD4453EC5C.quest_subtitle: "Leve ao forno para preparar"
	quest.2EE8474E8F1623C8.quest_subtitle: "Monitorar a temperatura do ambiente"
	quest.2F658AF3CB304405.title: "Era do Ferro"
	quest.32398409D2285B9D.title: "Longsword of the Plage"
	quest.33BE05E88CB9FDB0.title: "Arquearia"
	quest.35DEE9F1BB0ED01E.quest_desc: [
		"Existem quatro estações, cada uma afeta vários fatores do ambiente, como o clima, duração dos dias, chuva/tempestades e plantações."
		""
		"- Primavera;"
		"- Verão;"
		"- Outono; e"
		"- Inverno"
	]
	quest.35DEE9F1BB0ED01E.quest_subtitle: "Estações do ano"
	quest.371546085FCFA24E.title: "Areia, Alga e Farinha de Osso"
	quest.3900CBE81E7F5CCD.title: "Filtro de Areia"
	quest.3A4AD3245DACC351.quest_subtitle: "Proteção contra o frio"
	quest.3A4AD3245DACC351.title: "Roupa de Pele de Cabra"
	quest.3DC019F4C7A97DD8.quest_desc: ["Você pode usar uma fogueira ou uma fornalha para purificar um recipiente com água suja. Dependendo do estado da água, você precisará repetir esse processo várias vezes."]
	quest.3DC019F4C7A97DD8.quest_subtitle: "Fazendo água potável"
	quest.3DC019F4C7A97DD8.title: "Purificando Água"
	quest.41FD0F2394AD707C.title: "Blazing Bow"
	quest.4202C32C3A071BD6.title: "Echo"
	quest.4301C34939C3D663.quest_desc: ["Coloque a Chaminé em cima de uma Caldeira para fazer ela funcionar."]
	quest.45156D316A742F5D.title: "Metalurgia"
	quest.4697349ADF077891.title: "Soulrender"
	quest.47023E0D5A89E83A.title: "Engenharia"
	quest.4C4D01F97E5DA513.quest_subtitle: "Vista uma armadura com proteção térmica"
	quest.4C4D01F97E5DA513.title: "Vestido para Ocasião"
	quest.4D9347DDC18871B5.quest_desc: ["Cuidado com biomas de baixa temperatura, no início do jogo eles são particularmente mais difíceis de sobreviver. Você pode usar uma fogueira ou outros blocos que emitem calor para sobreviver do frio."]
	quest.4D9347DDC18871B5.quest_subtitle: "Cuidado com o frio"
	quest.520514D76C230444.quest_desc: [
		"Você precisará tomar cuidado com a sua temperatura corporal. Dependendo do ambiente, se estiver muito frio ou muito calor você sofrerá penalidades, como lentidão ou distorções visuais, e, em casos extremos, você receberá dano. Fique de olho no indicador de temperatura corporal."
		""
		""
	]
	quest.520514D76C230444.quest_subtitle: "Cuidado com a temperatura"
	quest.520514D76C230444.title: "Temperatura"
	quest.521955ACF3E77C5E.title: "Exploração"
	quest.53C561294DA1CFE0.quest_desc: [
		"O inverno é a quarta estação do ano para os biomas temperados. Ele é dividido em três subestações: Início do Inverno, Meio do Inverno e Fim do Inverno. Cada subestação dura 8 dias no jogo, por padrão."
		""
		"No inverno, a grama e a folhagem perdem a cor."
		""
		"As temperaturas dos biomas caem, permitindo que a neve comece a cair nos biomas temperados. A precipitação também é mais frequente no inverno, mas não ocorrem tempestades."
	]
	quest.54B63C74D9DAB6EF.title: "Caçador de Monstros"
	quest.55DB77A64EA1D7B2.title: "Everbloom"
	quest.57AC5EF7668BFF46.title: "Bruxaria"
	quest.5B09EEFF1393B6A1.quest_subtitle: "Clique com o botão direito para coletar água"
	quest.5C82E01B07C5D7A8.quest_subtitle: "Permite a criação de portais quânticos"
	quest.5C82E01B07C5D7A8.title: "Mecânica Quântica"
	quest.646751112566037E.quest_desc: ["Clique com Sílex em uma pedra para transformar em Fragmentos de Sílex"]
	quest.6A3108D7CE85B5D0.quest_subtitle: "Coletar argila"
	quest.6B0E761D48BE29D6.title: "Coletar Madeira"
	quest.71BFDCF3CA4F42D6.quest_desc: [
		"A função da Mesa de Costura é revestir peças de armadura com materiais especiais para aumentar sua proteção térmica."
		""
		"Você pode repetir esse processo na mesma peça de armadura para empilhar o nível de proteção térmica."
		""
		"Para remover um nível de proteção e recuperar o material térmico, utilize uma tesoura e coloque-a no slot de material."
	]
	quest.71BFDCF3CA4F42D6.quest_subtitle: "Melhorando armaduras"
	quest.743B730129C3D0E2.quest_desc: ["Nem todas as fontes de água são potáveis. Recolher água de um rio ou do oceano resultará em um container com Água Suja. Você pode ficar doente ao beber água não-potável."]
	quest.743B730129C3D0E2.quest_subtitle: "Qualidade da água"
	quest.743B730129C3D0E2.title: "Fontes de Água"
	quest.755F74EBAEB81D15.quest_desc: [
		"O verão é a segunda estação do ano para biomas temperados. Ele é dividido em três subestações: início do verão, meio do verão e final do verão. Cada subestação dura 8 dias no jogo por padrão."
		""
		"No verão, a grama e a folhagem adquirem uma tonalidade verde-amarelada."
		""
		"Tempestades também são mais comuns no verão."
	]
	quest.7DCE2F81B36B91E2.title: "Era do Bronze"
	quest.7E4E644AF4C61F6A.quest_desc: [
		"Você precisa beber água para sobreviver. Fique de olho no indicador de sede na interface. Você perderá vida se o indicador de sede chegar a zero."
		""
		"{image:thirst:textures/gui/thirst_icons.png width:74 height:24 align:center}"
	]
	quest.7E4E644AF4C61F6A.quest_subtitle: "Você precisa beber água."
	quest.7E4E644AF4C61F6A.title: "Beba Água"
	quest.7E825F7FF1BD69A4.quest_desc: [
		"A primavera é a primeira estação do ano para os biomas temperados. Ela é dividida em três subestações: início da primavera, meio da primavera e final da primavera. Cada subestação dura 8 dias no jogo, por padrão."
		""
		"Na primavera, a grama e a folhagem adquirem uma coloração verde-azulada, e as temperaturas dos biomas começam a subir, saindo do inverno em direção ao final da estação, derretendo a neve nos biomas mais quentes. A precipitação também é mais frequente na primavera."
	]
	quest.7E825F7FF1BD69A4.title: "Primavera"
