{
	chapter.0C785D04B26395BD.title: "Água e Sede"
	chapter.1E39E785067E94ED.title: "Origem"
	chapter.29BC9230AC7DB921.title: "Temperatura"
	chapter_group.124F2CFDEDC92334.title: "Sistemas"
	quest.00914B4D6DA3D4F6.quest_subtitle: "Somente uma origem pode ser selecionada"
	quest.00914B4D6DA3D4F6.title: "Selecione uma origem"
	quest.0380EC41C3B145D0.quest_desc: [
		"O outono é a terceira estação do ano para os biomas temperados. Ele é dividido em três subestações: início do outono, meio do outono e final do outono. Cada subestação dura 8 dias no jogo, por padrão."
		""
		"No outono, a grama adquire uma coloração amarelada, enquanto a folhagem ganha um tom alaranjado, que atinge seu ápice de vivacidade. As temperaturas dos biomas começam a cair no final da estação, dando lugar ao inverno, e alguns biomas mais frios podem até começar a receber neve antes da chegada do inverno."
	]
	quest.0564C4F9C337ABB5.title: "Estanho e Cobre"
	quest.072872707C9CAD72.title: "Stormbringer"
	quest.0A8849C79848EEEF.title: "Biologia Marinha"
	quest.0B96398E08F8B009.quest_desc: [
		"Clique com o botão direito na água para encher."
		""
		"Coloque em uma Caixa de Gelo para esfriar. Carregar uma Bolsa de Água congelada esfria o corpo temporariamente."
		""
		"Coloque em uma fornalha ou fogueira para esquentar. Carregar uma Bolsa de Água quente aquece o corpo temporariamente."
	]
	quest.0EB27C9D51B69D57.title: "Água"
	quest.12155F9F361B8423.quest_desc: ["Utilize a Caldeira para esquentar/esfriar o ambiente próximo dependendo do material de combustível."]
	quest.127F433C5A67A121.title: "Pedra"
	quest.17FC24993BDA13FE.quest_desc: ["Cuidado com biomas como desertos e selvas, pois nestes a temperatura pode ser muito alta, tendo seu pico ao meio dia. Mergulhar na água ou ficar próximos a blocos que absorvem calor (como Gelo) pode ajudar a esfriar um pouco."]
	quest.17FC24993BDA13FE.quest_subtitle: "Cuidado com o calor"
	quest.191F51FB86BF50C5.title: "Era do Cobre"
	quest.1B4CD8FCC9B9F765.quest_desc: ["Use a Ferramenta de Argila em um bloco de Argila para criar um balde."]
	quest.1B6C73BF212BFBEF.quest_subtitle: "Use para criar uma fogueira"
	quest.1C5F5E0A87FBD135.quest_desc: ["Adicione uma Bolsa de Água na Caixa de Gelo para esfriar. Segurar uma Bolsa de Água congelada na mão lentamente esfria o corpo e permite suportar altas temperaturas temporariamente."]
	quest.1C663FB18BA3FE6F.quest_desc: [
		"Alguns materiais especiais podem ser adicionados a peças de armaduras para aumentar a proteção térmica que elas oferecem. Esse processo pode ser feito na Mesa de Costura."
		""
		""
	]
	quest.1C663FB18BA3FE6F.quest_subtitle: "Aumentar o isolamento térmico de armaduras"
	quest.1C663FB18BA3FE6F.title: "Isolantes Térmicos"
	quest.1E511D530457F5AB.quest_subtitle: "Proteção contra o calor"
